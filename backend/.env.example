# Copy to backend/.env and fill in. Variables already set in the shell win.
PORT=8080
# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL=postgres://dfs:dfs@localhost:5432/deutschfremsprache?sslmode=disable
# Audio files (recordings + TTS cache) are stored here, not in the database.
DATA_DIR=./data
# Built frontend served by the Go server (production). Ignored in Vite dev mode.
STATIC_DIR=../frontend/dist
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Azure Speech resource (Azure Portal -> Speech service -> Keys and Endpoint).
# Leave empty to run in mock mode (browser TTS, fake scores).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Vietnamese meanings. With an Azure Translator key (F0 tier: 2M chars/month free)
# translations are much better; without one the free MyMemory API is used.
AZURE_TRANSLATOR_KEY=
# Defaults to AZURE_SPEECH_REGION. Use "global" for a global Translator resource.
AZURE_TRANSLATOR_REGION=
# Optional: raises MyMemory's free daily quota (5k -> 50k chars/day).
MYMEMORY_EMAIL=
# Price estimates for the cost page (USD). Check your region's real prices.
AZURE_ASSESS_USD_PER_HOUR=2.0
AZURE_TRANSLATOR_USD_PER_MILLION_CHARS=10
# OpenAI: "Tạo bằng AI" (topic scripts) and German reference speech (TTS).
# Leave empty to disable AI generation; German then uses the browser voice.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_USD_PER_M_INPUT=0.40
OPENAI_CHAT_USD_PER_M_OUTPUT=1.60
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# gpt-4o-mini-tts is token-billed; this per-minute figure is OpenAI's estimate.
OPENAI_TTS_USD_PER_MINUTE=0.015
# Used instead for tts-1 / tts-1-hd (billed per character).
OPENAI_TTS_USD_PER_MILLION_CHARS=15

# Flashcard pictures drawn by AI ("✨ Ảnh"), and the price used for cost tracking.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_USD=0.011
# Plain speech-to-text (simulations transcribe free speech before grading it).
AZURE_STT_USD_PER_HOUR=1.0

# Generated audio storage. With S3_BUCKET set, clips go to S3 and the browser
# plays them through presigned URLs; otherwise they are kept in DATA_DIR/media.
S3_BUCKET=
AWS_REGION=eu-central-1
S3_PREFIX=deutschfremsprache
# Leave the keys empty to use the default AWS credential chain (env, ~/.aws, IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for S3-compatible services (Cloudflare R2, MinIO, …).
S3_ENDPOINT=

# Pronunciation score (0-100) needed for a sentence to pass and be saved.
PASS_THRESHOLD=70
# Word accuracy below this is marked as mispronounced (bold red).
WORD_THRESHOLD=60
# Frontend origins allowed to call the API when it runs on another domain (Vercel).
# Comma-separated; "https://*.vercel.app" also allows preview deployments.
# e.g. CORS_ORIGIN=https://deutsch.example.com,https://*.vercel.app
CORS_ORIGIN=
# Public base URL of this API (no trailing slash), e.g. https://api.example.com.
# Needed when the frontend is on another domain, so picture/audio links are absolute.
PUBLIC_URL=
# The only user who may open the cost page (/usage). Default: 1 (the first account).
ADMIN_USER_ID=1
